# ============================================================
# .env.example — Hax-ISA Backend Configuration
# Copiare in .env e configurare i valori
# ============================================================

# Ambiente
NODE_ENV=development

# Porta server
PORT=3000

# MongoDB — URI di connessione
# Locale:  mongodb://localhost:27017/hax_isa
# Atlas:   mongodb+srv://user:password@cluster.mongodb.net/hax_isa
MONGODB_URI=mongodb://localhost:27017/hax_isa
MONGODB_DB_NAME=hax_isa

# JWT — Chiave segreta (minimo 32 caratteri, usare stringa casuale)
JWT_SECRET=hax_isa_super_secret_key_change_in_production_32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS — Origini consentite (separare con virgola)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3001

# Upload immagini
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin default (solo per primo avvio / seed)
ADMIN_EMAIL=admin@hax-isa.it
ADMIN_PASSWORD=Admin@HAX2024!

# Log
LOG_LEVEL=info

# ============================================================
# CLOUDINARY — Upload immagini veicoli
# Credenziali da: https://cloudinary.com/console
# ============================================================
CLOUDINARY_CLOUD_NAME=tuo_cloud_name
CLOUDINARY_API_KEY=tua_api_key
CLOUDINARY_API_SECRET=tuo_api_secret
